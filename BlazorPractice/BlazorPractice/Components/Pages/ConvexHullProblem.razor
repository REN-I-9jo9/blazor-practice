@page "/convex-hull-problem"
@using BlazorPractice.Library
@inject IJSRuntime JS

<PageTitle>Blazor Practice - Convex Hull Problem</PageTitle>

<style>
    canvas {
        width: 100%;
        height: 100%;
    }

    .point-display-table-container {
        position: relative;
    }

    .point-display-table {
        position: absolute;
        top: 10px;
        left: 10px;
    }
</style>
<div class="point-display-table-container">
    <div class="point-display-table">
        <Button Color="ButtonColor.Primary" @onclick="OnShowModalClick">
            <Icon Name="IconName.List" />
        </Button>
    </div>
</div>
<Modal @ref="modal" Title="Points" OnHidden="OnModalHidden">
    <BodyTemplate>
        <Grid @ref="grid" TItem="Point" Class="table table-hover table-bordered table-striped" DataProvider="EmployeesDataProvider" Responsive="true">
            <GridColumns>
                <GridColumn TItem="Point" HeaderText="X">
                    <NumberInput TValue="int" @bind-Value=" @context.X" Placeholder="Enter amount" />
                </GridColumn>
                <GridColumn TItem="Point" HeaderText="Y">
                    <NumberInput TValue="int" @bind-Value=" @context.Y" Placeholder="Enter amount" />
                </GridColumn>
                <GridColumn TItem="Point">
                    <Button Color="ButtonColor.None" @onclick="(e => DeleteItem(context))"><Icon Name="IconName.Trash" /></Button>
                </GridColumn>
            </GridColumns>
        </Grid>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.None" @onclick="AddNewItem">Add New</Button>
        <Button Color="ButtonColor.None" @onclick="RandomlizeAll">Randomlize All</Button>
    </FooterTemplate>
</Modal>
<canvas id="@CanvasID" />

@code {

    private Grid<Point> grid;

    private class Point
    {
        public int X;
        public int Y;
    }
    const string CanvasID = "myCanvas";
    private List<Point> PointList;
    protected override void OnInitialized()
    {
        PointList = new List<Point>
        {
            new Point { X = 107, Y = 107},
            new Point { X = 103, Y = 107},
            new Point { X = 106, Y = 107}
        };
    }
    private async Task<GridDataProviderResult<Point>> EmployeesDataProvider(GridDataProviderRequest<Point> request)
    {
        return await Task.FromResult(request.ApplyTo(PointList));
    }

    private BlazorCanvas blazorCanvas;

    private BlazorCanvasContext2D blazorCanvasContext2D;

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            blazorCanvas = await BlazorCanvas.Get(JS, CanvasID);
            await RefreshCanvas();
            blazorCanvasContext2D = await BlazorCanvasContext2D.Get(JS, CanvasID, "2d");
            await DrawPlane();
        }
    }

    private async Task RefreshCanvas()
    {
        await blazorCanvas.SetWidth(await blazorCanvas.GetOffsetWidth());
        await blazorCanvas.SetHeight(await blazorCanvas.GetOffsetHeight());
    }

    private async Task DrawPlane()
    {
        var canvasWidth = (int)await blazorCanvas.GetOffsetWidth();
        var canvasHeight = (int)await blazorCanvas.GetOffsetHeight();

        await blazorCanvasContext2D.MoveTo(-1, canvasHeight / 2);
        await blazorCanvasContext2D.LineTo(canvasWidth + 1, canvasHeight / 2);
        await blazorCanvasContext2D.Stroke();

        await blazorCanvasContext2D.MoveTo(canvasWidth / 2, -1);
        await blazorCanvasContext2D.LineTo(canvasWidth / 2, canvasHeight + 1);
        await blazorCanvasContext2D.Stroke();
    }

    private async Task OnModalHidden()
    {
        await RefreshCanvas();
        await DrawPlane();
    }

    private Modal modal;

    private async Task OnShowModalClick()
    {
        await modal?.ShowAsync();
    }

    private async Task AddNewItem()
    {
        PointList.Add(new Point { });
        await grid.RefreshDataAsync();
    }

    private async Task DeleteItem(Point item)
    {
        PointList.Remove(item);
        await grid.RefreshDataAsync();
    }

    private async Task RandomlizeAll()
    {
        var random = new Random();

        var canvasWidth = (int)await blazorCanvas.GetOffsetWidth();
        var canvasHeight = (int)await blazorCanvas.GetOffsetHeight();

        foreach (var point in PointList)
        {
            point.X = (int)random.NextInt64(-(canvasWidth / 2), canvasWidth / 2);
            point.Y = (int)random.NextInt64(-(canvasHeight / 2), canvasHeight / 2);
        }
        await grid.RefreshDataAsync();
    }
}
