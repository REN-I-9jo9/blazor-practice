@page "/langtons-ant"
@using BlazorPractice.Library
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Blazor Practice - Langton's Ant</PageTitle>
<style>
    canvas {
        width: 100%;
        height: 100%;
    }

    .point-display-table-container {
        position: relative;
    }

    .point-display-table {
        position: absolute;
        top: 10px;
        left: 10px;
    }
</style>
<div class="point-display-table-container">
    <div class="point-display-table">
        <table class="table">
            <tbody>
                @foreach (var point in Points)
                {
                    <tr>
                        <td>
                            <button type="button" class="btn btn-primary" style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .25rem; --bs-btn-font-size: .75rem;">
                                <div style="width:50px;">@point</div>
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-primary" style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .25rem; --bs-btn-font-size: .25rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
                <tr>
                    <td>                    </td>
                    <td>
                        <button type="button" class="btn btn-primary" style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .25rem; --bs-btn-font-size: .25rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                            </svg>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<canvas id="@CanvasID" />
@code {
    const string CanvasID = "myCanvas";

    public List<Point> Points = new List<Point>();

    public LangtonsAnt()
    {
        Points.Add(new Point { X = 0, Y = 0 });
        Points.Add(new Point { X = 0, Y = 0 });
        Points.Add(new Point { X = 0, Y = 0 });
        Points.Add(new Point { X = 0, Y = 0 });
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        var canvas = await BlazorCanvas.Get(JS, CanvasID);
        await canvas.SetWidth(await canvas.GetOffsetWidth());
        await canvas.SetHeight(await canvas.GetOffsetHeight());

        var context = await BlazorCanvasContext2D.Get(JS, CanvasID, "2d");
        await context.MoveTo(0, 0);
        await context.LineTo(200, 100);
        await context.Stroke();
    }
}
