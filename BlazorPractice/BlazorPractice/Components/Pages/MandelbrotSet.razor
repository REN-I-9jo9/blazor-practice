@page "/mandelbrot-set"
@using System.Drawing
@using BlazorPractice.Library
@inject IJSRuntime JS

<PageTitle>Blazor Practice - Mandelbrot Set</PageTitle>

<style>
    canvas {
        position: absolute;
        width: 100%;
        height: 100%;
    }

    .point-display-table-container {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .point-display-table {
        position: absolute;
        top: 10px;
        left: 10px;
        display: flex;
        gap: 10px;
    }
</style>
<div class="point-display-table-container">
    <canvas id="@CanvasID" />
    <div class="point-display-table">
        <Button Color="ButtonColor.Primary" @onclick="OnShowModalClick">
            <Icon Name="IconName.List" />
        </Button>
    </div>
</div>
<Modal @ref="modal" Title="Title" OnHidden="OnModalHidden">
    <BodyTemplate>
        
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.None">Button</Button>
    </FooterTemplate>
</Modal>
@code {
    const string CanvasID = "CoordinateCanvasID";
    protected override void OnInitialized()
    {
    }

    private BlazorCanvas canvas;

    private BlazorCanvasContext2D canvasContext2D;

    private Modal modal;

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            canvas = await BlazorCanvas.Get(JS, CanvasID);
            await RefreshCanvas(canvas);
            canvasContext2D = await BlazorCanvasContext2D.Get(JS, CanvasID, "2d");

            await canvasContext2D.MoveTo(0, 0);
            await canvasContext2D.LineTo(100, 100);
            await canvasContext2D.Stroke();

            var imagedata = await canvasContext2D.getImageData(0, 0, 100, 100);
            var data = await imagedata.GetData(JS);

            var random = new Random();
            for(var i=0;i<data.Length;i++)
            {
                data[i] = (byte)random.NextInt64(0, 255);
            }

            var q = await ImageData.New(JS, data, 100, 100);

            
            await canvasContext2D.PutImageData(imagedata, 0, 100);
            await canvasContext2D.PutImageData(q, 0, 200);

        }
    }

    private async Task RefreshCanvas(BlazorCanvas canvas)
    {
        await canvas.SetWidth(await canvas.GetOffsetWidth());
        await canvas.SetHeight(await canvas.GetOffsetHeight());
    }

    private async Task OnShowModalClick()
    {
        await modal?.ShowAsync();
    }

    private async Task OnModalHidden()
    {
        
    }
}
